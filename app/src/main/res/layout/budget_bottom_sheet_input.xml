<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:spacing="16dp">

        <!-- Title -->
        <EditText
            android:id="@+id/editTextTitle"
            android:hint="Title"
            android:inputType="textCapSentences"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="12dp"
            android:background="@drawable/rounded_corner"/>

        <!-- Date Picker Trigger -->
        <TextView
            android:id="@+id/textViewBudgetDate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Date"
            android:padding="12dp"
            android:textSize="16sp"
            android:background="@drawable/rounded_corner"
            android:layout_marginTop="16dp"/>

        <!-- Start Time Picker Trigger -->
        <TextView
            android:id="@+id/textViewBudgetStartTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select Start Time"
            android:padding="12dp"
            android:textSize="16sp"
            android:background="@drawable/rounded_corner"
            android:layout_marginTop="16dp"/>

        <!-- End Time Picker Trigger -->
        <TextView
            android:id="@+id/textViewBudgetEndTime"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Select End Time"
            android:padding="12dp"
            android:textSize="16sp"
            android:background="@drawable/rounded_corner"
            android:layout_marginTop="16dp"/>

        <!-- Minimum Amount -->
        <EditText
            android:id="@+id/editTextMinAmount"
            android:hint="Enter Minimum Amount"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner"/>

        <!-- Maximum Amount -->
        <EditText
            android:id="@+id/editTextMaxAmount"
            android:hint="Enter Maximum Amount"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/rounded_corner"/>

        <!-- Amount -->
        <EditText
            android:id="@+id/editTextAmount"
            android:hint="Enter Amount"
            android:inputType="numberDecimal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:padding="12dp"
            android:layout_marginTop="16dp"
            android:background="@drawable/login_background"/>

        <!-- Submit Button -->
        <Button
            android:id="@+id/buttonSubmit"
            android:text="Add Expense"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="@color/orange"
            android:textColor="@android:color/white"/>
    </LinearLayout>
</ScrollView>
